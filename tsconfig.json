{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "paths": {
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@pages/*": ["./src/pages/*"],
      "@images/*": ["./src/assets/images/*"],
      "@videos/*": ["./src/assets/videos/*"],
      "@utilities/*": ["./src/utilities/*"]
    }
  },
}
