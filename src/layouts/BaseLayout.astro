---
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import '@styles/global.css';
import { Font, getImage } from 'astro:assets';
import { SiteHeader } from '@components/SiteHeader';
import { GlobalFooter } from '@components/GlobalFooter/GlobalFooter';
import { FooterLocal } from '@components/FooterLocal';
import bgTree from '@images/bg-tree.jpg';

interface Props {
  title?: string;
  description?: string;
  activeLabel?: string;
  theme?: 'light' | 'dark';
  ogImage?: ImageMetadata;
}

const {
  title = 'Stanford Web Services',
  description = 'Stanford Web Services is Stanford University’s in-house digital agency, providing strategy, design, and engineering for university schools and departments.',
  activeLabel,
  theme = 'light',
  // Placeholder social-share image; replace with a purpose-made 1200x630 asset.
  ogImage = bgTree,
} = Astro.props;

const pageTitle = `${title} | Stanford Web Services`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageAsset = await getImage({
  src: ogImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
const ogImageURL = new URL(ogImageAsset.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/icon1.png" sizes="192x192" type="image/png">
    <link rel="icon" href="/icon2.png" sizes="180x180" type="image/png">
    <link rel="icon" href="/icon3.png" sizes="128x128" type="image/png">
    <link rel="icon" href="/icon4.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/icon5.png" sizes="16x16" type="image/png">
    <link rel="apple-touch-icon" href="/icon2.png" />
    <Font cssVariable="--font-serif" />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-stanford" />
    {import.meta.env.PROD && (
      <>
        <!-- Google Tag Manager -->
        <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-P8XKF6XL');
        </script>
        <!-- End Google Tag Manager -->
      </>
    )}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Stanford Web Services" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P8XKF6XL"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <SiteHeader client:load theme={theme} activeLabel={activeLabel} />
    <main id="main-content" tabindex={-1} class="relative">
      <slot />
    </main>
    <FooterLocal activeLabel={activeLabel} />
    <GlobalFooter />
  </body>
</html>

<ClientRouter />
