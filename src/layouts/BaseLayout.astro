---
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import '@styles/global.css';
import { Font, getImage } from 'astro:assets';
import { SiteHeader } from '@components/SiteHeader';
import { GlobalFooter } from '@components/GlobalFooter/GlobalFooter';
import { FooterLocal } from '@components/FooterLocal';
import social from '@images/sws-social.jpg';
import {
  type WebPageType,
  breadcrumbNode,
  organizationNode,
  organizationStub,
  webPageNode,
  websiteNode,
  websiteStub,
} from '@utilities/schema';

interface Props {
  /** Short page name, used for breadcrumbs and the default `<title>`. */
  title?: string;
  /** Full `<title>` override when the default "{title} | Stanford Web Services" isn't descriptive enough. */
  metaTitle?: string;
  description?: string;
  activeLabel?: string;
  theme?: 'light' | 'dark';
  ogImage?: ImageMetadata;
  /** Alt text for ogImage; required whenever ogImage is overridden. */
  ogImageAlt?: string;
  noindex?: boolean;
  /** schema.org WebPage subtype for this page's JSON-LD. */
  pageType?: WebPageType;
  /** Primary thing the page is about (e.g. an ItemList of services or projects). */
  mainEntity?: Record<string, unknown>;
}

const {
  title,
  metaTitle,
  description = 'Stanford Web Services is Stanford University’s in-house digital agency, providing strategy, design, and engineering for university schools and departments.',
  activeLabel,
  theme = 'light',
  ogImage = social,
  ogImageAlt = 'Stanford Web Services, University IT, over a tree-lined walkway on the Stanford campus',
  noindex = false,
  pageType = 'WebPage',
  mainEntity,
} = Astro.props;

const pageTitle = metaTitle ?? (title ? `${title} | Stanford Web Services` : 'Stanford Web Services');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isHomepage = Astro.url.pathname === '/';
const ogImageAsset = await getImage({
  src: ogImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
const ogImageURL = new URL(ogImageAsset.src, Astro.site);

// One JSON-LD graph per page. The full Organization and WebSite are published
// on the homepage only; other pages get stubs with the same @id plus a breadcrumb.
// Noindex pages get none.
const url = canonicalURL.href;
const breadcrumbId = isHomepage ? undefined : `${url}#breadcrumb`;
const webPage = webPageNode({
  type: pageType,
  url,
  name: pageTitle,
  description,
  imageUrl: ogImageURL.href,
  breadcrumbId,
  mainEntity,
});
const graph = breadcrumbId
  ? [organizationStub(), websiteStub(), webPage, breadcrumbNode(breadcrumbId, url, title ?? pageTitle)]
  : [organizationNode(), websiteNode(), webPage];
const jsonLd = noindex ? null : { '@context': 'https://schema.org', '@graph': graph };
// Netlify sets CONTEXT at build time; deploy previews and branch deploys must not send analytics.
const loadGTM = process.env.CONTEXT === 'production';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/icon1.png" sizes="192x192" type="image/png">
    <link rel="icon" href="/icon2.png" sizes="180x180" type="image/png">
    <link rel="icon" href="/icon3.png" sizes="128x128" type="image/png">
    <link rel="icon" href="/icon4.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/icon5.png" sizes="16x16" type="image/png">
    <link rel="apple-touch-icon" href="/icon2.png" />
    {/* Preloaded: every page's LCP element is a large font-serif text block. */}
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-stanford" />
    {loadGTM && (
      <>
        <!-- Google Tag Manager -->
        <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-P8XKF6XL');
        </script>
        <!-- End Google Tag Manager -->
      </>
    )}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL.href} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Stanford Web Services" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
    <!-- Content is SSR'd with motion's hidden state (opacity:0); force visible when JS can't hydrate. -->
    <noscript>
      <style>
        [data-animate] {
          opacity: 1 !important;
          transform: none !important;
          filter: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="flex min-h-dvh flex-col">
    {loadGTM && (
      <>
        <!-- Google Tag Manager (noscript) -->
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P8XKF6XL"
          height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <!-- End Google Tag Manager (noscript) -->
      </>
    )}
    <SiteHeader client:load theme={theme} activeLabel={activeLabel} />
    <main id="main-content" tabindex={-1} class="relative grow">
      <slot />
    </main>
    <footer>
      <FooterLocal client:load activeLabel={activeLabel} />
      <GlobalFooter />
    </footer>
  </body>
</html>

<ClientRouter />
