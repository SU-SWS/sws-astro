---
import { CtaLink } from '@components/CtaLink';
import { ServiceSection } from '@components/sections/services/ServiceSection';
import { Container } from '@components/Container/Container';
import { ClientLogosSection } from '@components/sections/ClientLogosSection';

const PRINCIPLES = [
  {
    title: 'Learn',
    body: 'We start by listening — then help you shape a strategy that fits your goals and your constraints.',
  },
  {
    title: 'Make',
    body: 'Our process is iterative by nature — we bring ideas to life early, then refine through collaboration until the work lands where it should.',
  },
  {
    title: 'Evolve',
    body: 'We think of everything we build as a living thing. After launch, we stay ready to maintain, refine, and grow it alongside you.',
  },
];

const SERVICES = [
  {
    title: 'Strategy',
    body:
      'We bring research, experience, and a deep understanding of Stanford’s best practices to every project. Whether that means defining a strategy, innovating on something new, or building on what already exists, we know how to navigate institutional requirements and find the right path forward.',
    items: ['Project discovery', 'Digital strategy', 'UX research', 'Information architecture'],
  },
  {
    title: 'Design',
    body:
      'We design interfaces that are as distinctive as the products they serve. Whether that means classical Stanford branding or something entirely your own. We build flexible, scalable design systems, ensuring every interaction is intuitive, consistent, and beautiful across everything from a single page annual report website to complex, API-driven applications.',
    items: ['Visual & interaction design', 'User experience', 'Prototyping', 'Design systems & guidelines'],
  },
  {
    title: 'Engineering',
    body:
      'We build for the product you need today and the product your need tomorrow.  We want your investment in technology to be maintainable and to grow with you. We listen closely to understand your ongoing needs, and pick technical approaches that fit into your existing workflows.',
    items: ['Website production', 'Custom development', 'Site building', 'Animation & motion design'],
  },
  {
    title: 'Continuous support, security, and performance',
    body:
      'Our ongoing services cover everything you need to stay secure, current, and effective — from security updates and infrastructure maintenance to feature development, content entry, and digital strategy. We build and maintain applications with security, stability, performance, and accessibility at the forefront, ensuring your platform meets the expectations of your local community while communicating your research to audiences around the world.',
    items: ['Security & maintenance', 'Hosting support', 'Analytics & UX monitoring', 'Accessibility support'],
  },
];

const WORK_TYPES = [
  {
    title: 'Extend your team',
    body: 'Keep your website content fresh during staff vacations. Save the hassle of hiring and onboarding a contract designer or developer to complete a large project. We can augment your team to help you deliver on your goals in whatever way makes the most sense for your context.',
  },
  {
    title: 'Guide vendors',
    body: 'Need a partner to translate your communication needs into technical requirements? We are fluent in agency-speak so you don’t have to be! We can help you avoid costly rework by ensuring your vendor understands your needs and Stanford’s requirements.',
  },
  {
    title: 'Fill gaps',
    body: 'Already have branding and designs, but don’t know how to bring it to life? Have a development team or a off-the shelf product, but need custom design? We are comfortable working with whatever teams and resources you already have lined up.',
  },
  {
    title: 'Level up',
    body: 'Keep up in these fast-paced times. We can work with you to bring your existing processes and practices into alignment with modern standards, including Stanford’s requirements for security and accessibility and emerging user behavior patterns and expectations.',
  },
];

const TECHNOLOGIES = [
  [
    'Drupal',
    'Netlify',
    'Figma',
    'AEM',
    'Looker Studio',
    'Storyblok',
    'Storybook',
    'Algolia',
    'Acquia',
    'Git',
    'React',
    'NextJS',
    'Coveo',
    'Pantheon',
    'Astro',
    'Tailwind CSS',
    'Vercel',
    'WordPress',
    'Google Analytics',
    'And more...',
  ],
];
---
<Container bgColor="black" as="section" pt={8} pb={7}>
  <h1 class="font-serif rs-mb-3 font-normal fluid-type-5 leading-display tracking-[0.01em] text-dark-primary">
    Services
  </h1>
  <p class="max-w-900 type-2 leading-cozy text-dark-primary-muted">
    We partner with teams across Stanford big and small. From a ten hour ux strategy consult to a multi-year program,
    we are here to help. We are committed to finding the right solution for your project and
    creating tools that empower you to do your best work, all while taking the guesswork out of security,
    accessibility, and infrastructure decisions. moving Stanford forward through digital experiences
    that help your users engage with the mission behind your work.
  </p>
</Container>

<Container bgColor="black" as="section" pb={6}>
  <div class="grid lg:grid-cols-3 lg:gap-60 2xl:gap-100">
    <ul class="list-unstyled grid rs-gap-4 lg:sticky lg:top-0 lg:self-start rs-pt-3">
      {PRINCIPLES.map((principle) => (
        <li class="mb-0">
          <div class="" aria-hidden />
          <h2 class="font-serif fluid-type-3 leading-display tracking-[0.01em] text-dark-primary">
            {principle.title}
          </h2>
          <p class="rs-mt-1 card-paragraph text-dark-secondary-muted mb-0">{principle.body}</p>
        </li>
      ))}
    </ul>

    <div class="rs-mt-8 lg:col-span-2">
      <div class="flex flex-col rs-gap-y-6">
        {SERVICES.map((service) => <ServiceSection {...service} />)}
      </div>
    </div>
  </div>
  <CtaLink href="/why" variant="link-dark" className="block! w-fit mx-auto rs-mt-6">Why partner with us</CtaLink>
</Container>

<Container bgColor="black" as="section" pt={9}>
  <div class="rs-px-6 rs-pt-6 rs-pb-5 mx-auto rounded-4xl border border-black-60">
    <p class="card-paragraph text-dark-secondary-muted">Collaboration</p>
    <h2 class="rs-pt-1 font-serif fluid-type-3 leading-display tracking-[0.01em] text-dark-primary">
      We flex to fit your needs
    </h2>
    <p class="rs-mt-2 max-w-900 big-paragraph text-dark-secondary-muted">
      We have many services, but we also know that one size doesn’t fit all.
      We can be embedded partners, on-demand specialists, or trusted advisors.
    </p>

    <ul class="list-unstyled max-w-1000 grid rs-gap-x-3 rs-gap-y-6 rs-pt-6 md:grid-cols-2">
      {WORK_TYPES.map((type) => (
        <li class="max-w-440 mb-0">
          <h3 class="font-serif fluid-type-1 leading-display text-dark-primary">{type.title}</h3>
          <p class="rs-mt-0 caption leading-display text-dark-secondary-muted">{type.body}</p>
        </li>
      ))}
    </ul>

    <div class="flex justify-center">
      <CtaLink href="/contact" variant="button-dark" className="rs-mt-6">Tell us what you need</CtaLink>
    </div>
  </div>
</Container>

<Container bgColor="black" as="section" pt={9} pb={9}>
  <div class="cc border-t border-black-60" aria-hidden="true" />
  <div class="max-w-1300 pt-27">
    <p class="caption text-dark-secondary-muted">Technologies</p>
    <h2 class="rs-pt-1 font-serif fluid-type-3 leading-display tracking-[0.01em] text-dark-primary">
      We work in
    </h2>
    <p class="rs-mt-2 max-w-900 card-paragraph leading-snug text-dark-secondary-muted mb-1em">
      Partnerships are our first commitment. We commit ourselves to working in numerous technologies, platforms,
      and languages to help you find the best solution. And,
      befitting a team embedded in Stanford’s culture of innovation, we are always up for new exploration.
    </p>
    <p class="rs-mt-2 max-w-900 card-paragraph leading-snug text-dark-secondary-muted">
      These are just a few of the products, platforms, and technologies in our current tool belt:
    </p>

    {TECHNOLOGIES.map((tech) => (
      <ul class="rs-mt-4 max-w-1000 mx-auto list-unstyled grid gap-x-20 gap-y-10 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5 text-dark-secondary-muted card-paragraph">
        {tech.map((item) => (
          <li class="mb-0">
            {item}
          </li>
        ))}
      </ul>
    ))}
  </div>
  <CtaLink
    href="/work"
    variant="link-dark"
    className="rs-mt-6 text-center mx-auto block! w-fit"
  >
    Learn more about our work
  </CtaLink>
</Container>

<ClientLogosSection ctaHref="/work" ctaLabel="Learn more about our work" ctaId="services-clients-cta" />
