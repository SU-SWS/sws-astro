---
import { Container } from '@components/Container/Container';
import { AnimateInView } from '@components/Animate/AnimateInView';
import { CtaLink } from '@components/CtaLink/CtaLink';
---

<Container bgColor="white" as="section" pt={8} pb={7}>
  <AnimateInView
    client:visible
    as="h1"
    className="font-serif rs-mb-3 font-normal fluid-type-4 leading-display"
  >
    Connect with us
  </AnimateInView>
  <AnimateInView
    client:visible
    as="p"
    delay={0.1}
    className="max-w-900 fluid-type-2 leading-cozy text-primary-muted text-pretty"
  >
    Ready to bring your vision to life? We’d love to hear about what you’re working on.
  </AnimateInView>
  <CtaLink variant="button-light" href="https://getsws.stanford.edu/" className="rs-mt-1">
    Request a consultation with SWS
  </CtaLink>
</Container>
