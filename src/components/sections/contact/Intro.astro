---
import { Container } from '@components/Container/Container';
import { AnimateInView } from '@components/Animate/AnimateInView';
---

<Container bgColor="white" as="section" pt={8} pb={7}>
  <AnimateInView
    client:visible
    as="h1"
    className="font-serif rs-mb-3 font-normal fluid-type-4 leading-display tracking-[0.01em]"
  >
    Connect with us
  </AnimateInView>
  <AnimateInView
    client:visible
    as="p"
    delay={0.1}
    className="max-w-900 fluid-type-2 leading-cozy text-primary-muted"
  >
    Tell us a little about the problem you’re trying to solve.
    We’re curious about any of the things you’re thinking about.
  </AnimateInView>
</Container>
