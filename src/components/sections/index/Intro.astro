---
import { Container } from '@components/Container/Container';
import { AnimateInView } from '@components/Animate/AnimateInView';
---

<Container pt={6} pb={7}>
  <h1 class="sr-only">
    Stanford Web Services homepage
  </h1>
  <AnimateInView client:visible as="p" className="mb-0 max-w-1000 mx-auto font-serif fluid-type-4 leading-snug text-primary">
    We build world-class websites and digital experiences that reflect the caliber
    of your work and the excellence of the team behind it — at any scale, for every vision.
  </AnimateInView>
</Container>
