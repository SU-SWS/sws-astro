---
import { Container } from '@components/Container/Container';
import { AnimateInView } from '@components/Animate/AnimateInView';
---

<Container pt={6} pb={7}>
  <!-- <AnimateInView
    client:visible
    as="h1"
    className="font-serif rs-mb-3 font-normal fluid-type-4 leading-display"
  >
    World-class work deserves a digital presence to match.
  </AnimateInView> -->
  <div class="flex flex-col lg:flex-row rs-gap-3">
    <AnimateInView
      client:visible
      as="h1"
      delay={0.1}
      className="font-serif font-normal basis-3/7 fluid-type-4 leading-cozy text-primary mb-0 text-pretty"
    >
      World-class work deserves a digital presence to match.
    </AnimateInView>
    <AnimateInView
      client:visible
      as="div"
      delay={0.2}
      animation="slideInFromRight"
      className="basis-4/7 text-pretty"
    >
      <p class="fluid-type-2 leading-cozy text-primary rs-mb-0">Your vision brought to life.</p>
      <p class="big-paragraph text-secondary-muted leading-normal text-primary-muted mb-0">
        Behind every breakthrough at Stanford is a human story.
        Your digital presence should honor those stories. Combining world-class aesthetics with smart,
        future-proof engineering, we create web experiences that feel intuitive, inspire action,
        and match the excellence of your work.
      </p>
    </AnimateInView>
  </div>
</Container>
