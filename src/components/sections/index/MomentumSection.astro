---
import { Image } from 'astro:assets';
import { Video } from '@components/Video/Video';
import { AnimateInView } from '@components/Animate/AnimateInView';
import { FeatureContent, type FeatureContentProps } from '@components/FeatureSection/FeatureContent';
import { FeatureSection } from '@components/FeatureSection/FeatureSection';
import momentumVideo from '@videos/moment2.mp4';
import posterMomentum from '@images/poster-momentum.png';
import bgMomentum from '@images/bg-momentum.jpg';
import awardCase from '@images/award-case.png';
import awardWebby from '@images/award-webby.png';

export const MomentumCommonContent: FeatureContentProps = {
  title: 'Momentum',
  description:
    'Momentum exists to tell Stanford’s most important stories — the research, discoveries, and human impact made possible through philanthropy. We partnered with the Office of Development to bring it to life, translating a vision and brand identity into an editorial platform built for dynamic, interactive storytelling.',
  awards: [
    {
      image: awardWebby,
      alt: '2025 Webby Nominee',
    },
    {
      image: awardCase,
      alt: '2025 CASE Circle of Excellence Award',
    },
  ],
  ctaLabel: 'Visit Momentum',
  ctaHref: 'https://momentum.stanford.edu/',
};
---

<FeatureSection ctaLabel="Learn more about our work" ctaHref="/work" ctaId="home-momentum-cta-learn-more">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <Image
      layout="full-width"
      src={bgMomentum}
      alt=""
      width={bgMomentum.width}
      height={bgMomentum.height}
      class="absolute inset-0 size-full object-cover"
    />
    <div class="absolute inset-0 bg-black-true/80" />
  </div>
  <FeatureContent
    {...MomentumCommonContent}
    eyebrow="Lasting partnerships"
    ctaId="home-momentum-cta"
  >
    <AnimateInView client:visible animation="fadeIn">
      <Video
        client:visible
        mp4Src={momentumVideo}
        posterSrc={posterMomentum.src}
        className="size-full rounded-md overflow-hidden"
      />
    </AnimateInView>
  </FeatureContent>
</FeatureSection>
