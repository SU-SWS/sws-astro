---
import { Image } from 'astro:assets';
import { Container } from '@components/Container/Container';
import { AnimateInView } from '@components/Animate/AnimateInView';
import bgTestimonial from '@images/bg-testimonial.jpg';

const TESTIMONIALS = [
  {
    quote:
      'SWS is creative, driven, thorough, and genuinely lovely to work with. They understand and embody the Stanford standards, from brand to accessibility, so you know your project is going to hit all the marks. We have built several high-stakes projects with SWS and have always been happy with the results.',
    name: 'Alexis Trivisonno',
    title: 'Director, Digital Strategy, Office of Development - Digital Strategy and Services',
  },
  {
    quote:
      'Technology grows in complexity year after year. With SWS on my team, I know I’ll be able to keep up with that complexity, to meet the goals set out to me by my leadership, and to ensure risk to the university is being managed. I work with SWS because they genuinely care about Stanford’s success, day in and day out.',
    name: 'Linnea Williams',
    title: 'Director, Communications Technology, University Communications',
  },
  {
    quote:
      'Working with SWS is a dream. They listen, share their knowledge and insights generously, and deliver work that is beautiful and functional.',
    name: 'Rebecca McClellan',
    title: 'Associate Director, Research Programs and Communications, Sarafan ChEM-H',
  },
];
---

<Container as="section" pt={7} pb={7} className="relative bg-archway-dark">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <Image
      layout="full-width"
      src={bgTestimonial}
      alt=""
      width={bgTestimonial.width}
      height={bgTestimonial.height}
      class="size-full object-cover"
    />
    <div class="absolute inset-0 bg-archway-dark/80" />
  </div>
  <div class="relative z-10">
    <h2 class="font-serif fluid-type-2 font-normal leading-display text-dark-primary">In their own words</h2>
    <ul class="relative list-unstyled rs-mt-5 grid rs-gap-x-4 rs-gap-y-5 lg:grid-cols-3">
      {TESTIMONIALS.map(({ quote, name, title }, index) => (
        <li class="mb-0">
          <AnimateInView as="figure" client:visible animation="sharpen" delay={index * 0.2}>
            <blockquote class="font-serif text-pretty type-0 leading-normal text-dark-primary max-w-prose">“{quote}”</blockquote>
            <figcaption class="rs-mt-1 text-09em">
              <span class="block text-fog/85">{name}</span>
              <span class="block text-[.8em] text-pretty text-fog/90">{title}</span>
            </figcaption>
          </AnimateInView>
        </li>
      ))}
    </ul>
  </div>
</Container>
