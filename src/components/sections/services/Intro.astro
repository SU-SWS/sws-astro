---
import { Container } from '@components/Container/Container';
import { AnimateInView } from '@components/Animate/AnimateInView';
---

<Container bgColor="black" as="section" pt={8} pb={7}>
  <AnimateInView
    client:visible
    as="h1"
    className="font-serif rs-mb-3 font-normal fluid-type-5 leading-display text-dark-primary"
  >
    Services
  </AnimateInView>
  <AnimateInView
    client:visible
    as="p"
    delay={0.1}
    className="max-w-900 fluid-type-2 leading-cozy text-dark-primary-muted"
  >
    Whether you need a one-time strategy consultation or a multi-year partnership,
    Stanford Web Services can help by creating high-quality digital experiences
    with the right tools so you can focus on the message,
    backed by our deep expertise in usability, security, accessibility, and infrastructure.
  </AnimateInView>
</Container>
