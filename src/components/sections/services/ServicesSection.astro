---
import { Image } from 'astro:assets';
import { AnimateInView } from '@components/Animate/AnimateInView';
import { Service } from '@components/Service/Service';
import { Container } from '@components/Container/Container';
import { CtaLink } from '@components/CtaLink/CtaLink';
import learnIcon from '@images/icon-learn.png';
import makeIcon from '@images/icon-make.png';
import evolveIcon from '@images/icon-evolve.png';

const PRINCIPLES = [
  {
    title: 'Discover',
    icon: learnIcon,
    body: 'We start by asking questions — about your goals, your vision, what’s working and what’s not — then shape a strategy that fits your needs.',
  },
  {
    title: 'Create',
    icon: makeIcon,
    body: 'We bring you into the creative process, sharing drafts and designs early and refining them together.',
  },
  {
    title: 'Evolve',
    icon: evolveIcon,
    body: 'Your goals may change over time. We’re here to maintain, refine, and grow alongside you.',
  },
];

const SERVICES = [
  {
    title: 'Strategy',
    body:
      'Every strong digital strategy starts with the right questions. We take the time to understand your goals, your stakeholders, and the people who will use what we create, and we bring our deep understanding of the university to deliver a strategy grounded in evidence and crafted to meet Stanford’s web standards and best practices.',
    items: [
      {
        service: 'Project discovery',
      },
      {
        service: 'Digital strategy',
      },
      {
        service: 'UX research',
      },
      {
        service: 'Information architecture',
      },
    ],
  },
  {
    title: 'Design',
    body:
      'We design with intention and work with you to create a distinct visual identity — whether that’s classic Stanford branding or something unique. From simple annual reports to complex, API-driven applications, we build flexible design systems where every interaction is intuitive, consistent, and crafted to a world-class standard.',
    items: [
      {
        service: 'Visual & interaction design',
      },
      {
        service: 'User experience',
      },
      {
        service: 'Prototyping',
      },
      {
        service: 'Design systems & guidelines',
      },
    ],
  },
  {
    title: 'Engineering',
    body:
      'We build for where you are now and where you’re headed. Technology should be easy to use and maintain, and able to change as your goals evolve. We take the time to understand how you work, then choose the best-in-class tools to fit — not the other way around.',
    items: [
      {
        service: 'Website production',
      },
      {
        service: 'Custom development',
      },
      {
        service: 'Site building',
      },
      {
        service: 'Animation & motion design',
      },
    ],
  },
  {
    title: 'Continuous support, security, and performance',
    body:
      'Our ongoing support services are built for the long term: keeping your platform secure, high-performing, accessible, and effective with the backing of a team you can count on. That means regular security and accessibility updates, infrastructure maintenance and monitoring, and support that’s there the moment something comes up.',
    items: [
      {
        service: 'Security & maintenance',
      },
      {
        service: 'Hosting support',
      },
      {
        service: 'Analytics & UX monitoring',
      },
      {
        service: 'Accessibility support',
      },
    ],
  },
];
---
<Container bgColor="black" as="section" pb={6}>
  <div class="grid lg:grid-cols-3 lg:gap-60 2xl:gap-100">
    <ul class="list-unstyled grid rs-gap-4 lg:sticky lg:top-0 lg:self-start rs-pt-2">
      {PRINCIPLES.map((principle, index) => (
        <li class="mb-0">
          <AnimateInView client:visible animation="zoomIn" delay={index * 0.2} className="w-fit">
            <Image src={principle.icon} alt="" width={principle.icon.width} height={principle.icon.height} />
          </AnimateInView>
          <h2 class="font-serif fluid-type-3 rs-mb-1 mt-10 leading-display text-dark-primary">
            {principle.title}
          </h2>
          <p class="max-w-prose card-paragraph leading-snug text-dark-secondary-muted mb-0">{principle.body}</p>
        </li>
      ))}
    </ul>

    <div class="rs-mt-9 lg:col-span-2">
      <ul class="list-unstyled flex flex-col rs-gap-8">
        {SERVICES.map((service) => (
          <li class="mb-0">
            <Service client:visible {...service} />
          </li>
        ))}
      </ul>
    </div>
  </div>
  <CtaLink href="/why/" variant="link-dark" className="block! w-fit mx-auto rs-mt-6">Why partner with us</CtaLink>
</Container>
