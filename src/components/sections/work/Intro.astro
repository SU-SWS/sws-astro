---
import { Container } from '@components/Container/Container';
import { AnimateInView } from '@components/Animate/AnimateInView';
---

<Container bgColor="white" as="section" pt={8} pb={7}>
  <AnimateInView
    client:visible
    as="h1"
    className="font-serif rs-mb-3 font-normal fluid-type-5 leading-display"
  >
    Our work
  </AnimateInView>
  <AnimateInView
    client:visible
    as="p"
    delay={0.1}
    className="max-w-900 fluid-type-2 leading-cozy text-secondary-muted"
  >
    From editorial platforms and microsites to complex, API-driven applications — our portfolio reflects years of
    designing and building digital experiences for Stanford, grounded in modern engineering,
    award-winning design, and a deep understanding of what the university needs.
  </AnimateInView>
</Container>
