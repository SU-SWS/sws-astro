---
import { Image } from 'astro:assets';
import { Video } from '@components/Video/Video';
import { FeatureContent } from '@components/FeatureSection/FeatureContent';
import { FeatureSection } from '@components/FeatureSection/FeatureSection';
import { ScreenshotGrid } from '../../../ScreenshotGrid';
import { stanfordSitesCells } from '../../../data/screenshotCells';
import momentumVideo from '@videos/momentum.mp4';
import posterMomentum from '@images/poster-momentum.png';
import bgMomentum from '@images/bg-momentum.jpg';
import bgTravelstudy from '@images/bg-travelstudy.jpg';
import bgPress from '@images/bg-press.jpg';
import bgArch from '@images/bg-partner.jpg';
import bgTree from '@images/bg-tree.jpg';
import centennialVideo from '@videos/centennial-adjusted4.mp4';
import posterCentennial from '@images/poster-centennial.png';
import { CentennialCommonContent } from '@components/sections/index/CentennialSection.astro';
import { MomentumCommonContent } from '@components/sections/index/MomentumSection.astro';
import screenshotDirectory from '@images/screenshot-directory.png';
import mobile1 from '@images/screenshot-mobile1.jpg';
import mobile2 from '@images/screenshot-mobile2.png';
import summer from '@images/screenshot-summer.jpg';
import travelStudyScreenshot from '@images/travelstudy-screenshot.jpg';
import pressScreenshot from '@images/press-screenshot.jpg';
---

{/* Momentum */}
<FeatureSection>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <Image
      layout="full-width"
      src={bgMomentum}
      alt=""
      width={bgMomentum.width}
      height={bgMomentum.height}
      class="absolute inset-0 size-full object-cover"
    />
    <div class="absolute inset-0 bg-black-true/80" />
  </div>
  <FeatureContent
    {...MomentumCommonContent}
    eyebrow={['Custom', 'Storyblok', 'Office of Development']}
    ctaId="work-momentum-cta"
  >
    <Video
      client:visible
      mp4Src={momentumVideo}
      posterSrc={posterMomentum.src}
      className="size-full"
    />
  </FeatureContent>
</FeatureSection>

{/* Centennial */}
<FeatureSection className="bg-cardinal-red-xdark">
  <FeatureContent
    {...CentennialCommonContent}
    textOnRight
    eyebrow={['Custom', 'Next.js', 'School of Engineering']}
    ctaId="work-centennial-cta"
  >
    <div class="sm:rs-px-5">
      <Video
        client:load
        mp4Src={centennialVideo}
        posterSrc={posterCentennial.src}
        className="size-full"
      />
    </div>
  </FeatureContent>
</FeatureSection>

{/* Stanford Sites */}
<FeatureSection>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <img src={bgTree.src} alt="" width={bgTree.width} height={bgTree.height} class="size-full object-cover" />
    <div class="absolute inset-0 bg-black-true/80" />
  </div>
  <FeatureContent
    eyebrow={['Platform', 'Drupal']}
    title="StanfordSites"
    description="Stanford Sites gives schools, departments, research labs, and individuals an easy path to create a website and ongoing support to maintain it. StanfordSites is free to use, continuously updated, and built on a platform designed to meet Stanford’s policies out of the box."
    ctaLabel="Request a Stanford Site"
    ctaHref="https://uit.stanford.edu/service/stanfordsites"
    ctaId="work-stanfordsites-cta"
  >
    <ScreenshotGrid
      client:visible
      gridClass="grid-stanford-sites"
      ariaLabel="Stanford Sites example screenshots"
      cells={stanfordSitesCells}
    />
  </FeatureContent>
</FeatureSection>

{/* Stanford Mobile app */}
<FeatureSection className="bg-linear-to-r from-sws-red-dark to-cardinal-red-xdark">
  <FeatureContent
    textOnRight
    eyebrow={['Custom', 'iOS / Android', 'University IT']}
    title="Stanford Mobile App: mobile key"
    description="Orci varius natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus. In pellentesque rutrum nisl, nec lacinia nibh."
    ctaLabel="Explore the app"
    ctaHref="https://apps.apple.com/us/app/stanford-mobile/id1495906858"
    ctaId="work-mobile-app-cta"
  >
    <div class="grid grid-cols-2 rs-gap-2 rs-px-4">
      <Image
        layout="constrained"
        src={mobile1}
        alt=""
        width={mobile1.width}
        height={mobile1.height}
        class="size-full rounded-md"
      />
      <Image
        layout="constrained"
        src={mobile2}
        alt=""
        width={mobile2.width}
        height={mobile2.height}
        class="size-full rounded-md"
      />
    </div>
  </FeatureContent>
</FeatureSection>

{/* Summer */}
<FeatureSection>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <Image
      layout="full-width"
      src={bgArch}
      alt=""
      width={bgArch.width}
      height={bgArch.height}
      class="size-full object-cover"
    />
    <div class="absolute inset-0 bg-palo-alto-dark/90" />
  </div>
  <FeatureContent
    eyebrow={['Custom', 'Drupal headless', '?']}
    title="Summer Session"
    description="We designed the Stanford Summer Session site to do two things well. To help prospective students quickly find what they’re looking for, and make them want to apply. A show-don’t-tell approach, real student voices, and sun-drenched California imagery bring the experience to life for a primarily international audience."
    ctaLabel="Visit Stanford Summer Session"
    ctaHref="https://summer.stanford.edu/"
    ctaId="work-summer-session-cta"
  >
    <Image
      layout="constrained"
      position="top"
      src={summer}
      alt=""
      width={summer.width}
      height={summer.height}
      class="size-full aspect-7/6 object-cover"
    />
  </FeatureContent>
</FeatureSection>

{/* Travel Study */}
<FeatureSection>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <Image
      layout="full-width"
      src={bgTravelstudy}
      alt=""
      width={bgTravelstudy.width}
      height={bgTravelstudy.height}
      class="size-full object-cover"
    />
    <div class="absolute inset-0 bg-black-true/80" />
  </div>
  <FeatureContent
    textOnRight
    eyebrow={['Custom', 'Storyblok', 'Alumni Association']}
    title="Stanford Alumni Travel/Study"
    description="The goal was simple — build an interactive experience worthy of the trips themselves. We collaborated with the Alumni Travel/Study team to design trip detail, browse, and list pages that are as beautiful and immersive as the destinations they represent, with clear information hierarchy, intuitive flow, and interactions that hold up against the best travel booking experiences in the industry."
    ctaLabel="Visit Travel/Study"
    ctaHref="https://alumni.stanford.edu/travel-study/"
    ctaId="work-travel-study-cta"
  >
    <Image
      layout="constrained"
      src={travelStudyScreenshot}
      alt=""
      width={travelStudyScreenshot.width}
      height={travelStudyScreenshot.height}
      class="size-full object-cover"
    />
  </FeatureContent>
</FeatureSection>

{/* SUP */}
<FeatureSection>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <Image
      layout="full-width"
      src={bgPress}
      alt=""
      width={bgPress.width}
      height={bgPress.height}
      class="size-full object-cover"
    />
    <div class="absolute inset-0 bg-linear-to-r from-palo-alto-dark/95 to-palo-verde/50" />
  </div>
  <FeatureContent
    eyebrow={['Custom', 'Drupal headless', 'Stanford University Press']}
    title="Stanford University Press"
    description="Stanford University Press needed a site as distinguished as its catalog. We worked with Stanford University Press to redesign their site with modern content hierarchy, intuitive book browsing and checkout, and a visual experience beautiful enough to match the caliber of their authors and their work."
    ctaLabel="Visit SUP"
    ctaHref="https://www.sup.org/"
    ctaId="work-sup-cta"
  >
    <Image
      layout="constrained"
      position="top"
      src={pressScreenshot}
      alt="Stanford University Press website"
      width={pressScreenshot.width}
      height={pressScreenshot.height}
      class="size-full object-cover aspect-square"
    />
  </FeatureContent>
</FeatureSection>

{/* My Account */}
<FeatureSection className="bg-fill-primary">
  <FeatureContent
    textOnRight
    eyebrow={['Web app', 'Next.js', 'Alumni Association']}
    title="Alumni: My Account"
    description="My Account is the central destination where Stanford alumni and constituents manage much of their personal data — from contact details and privacy settings to professional information, and more. Designed and built by teams across Stanford, it serves as an important part of the alumni and constituent digital ecosystem, where account and profile updates are managed and stored in a single application."
  ></FeatureContent>
</FeatureSection>

{/* Directory */}
<FeatureSection className="bg-linear-to-r from-sws-red-dark to-cardinal-red-xdark">
  <FeatureContent
    eyebrow={['Web app', 'Next.js', 'Alumni']}
    title="Alumni Directory"
    description="The Directory is where Stanford’s community finds itself. Powered by My Account, it gives students and alumni a powerful, intuitive way to discover connections that support their professional and personal goals — designed from the ground up to make search feel effortless and results feel meaningful."
  >
    <Image
      layout="constrained"
      src={screenshotDirectory}
      alt="Alumni Directory website"
      width={screenshotDirectory.width}
      height={screenshotDirectory.height}
      class="size-full object-cover"
    />
  </FeatureContent>
</FeatureSection>
